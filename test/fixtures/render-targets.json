        "whatsapp": [
          "Here is `**literal**` and *bold*."
        ],
        "telegram": [
          "Here is `**literal**` and **bold**."
        ],
        "signal": [
          "Here is `**literal**` and bold."
        ],
        "imessage": [
          "Here is `**literal**` and bold."
        ],
        "messaging": [
          "Here is `**literal**` and *bold*."
        ],
        "latex": [
          "Here is `**literal**` and **bold**."
        ]
      }
    },
    {
      "name": "messaging targets normalize 4+ backtick code fences to triple backticks",
